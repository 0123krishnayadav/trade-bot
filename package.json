{
  "name": "trade-bot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "1.4.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "login": "bun run src/login.ts",
    "upstox": "bun run src/brokers/upstox/cli.ts",
