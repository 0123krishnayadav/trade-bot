# Copy to .env and fill in. Bun loads .env automatically; never commit .env.

# development | test | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info
# pretty (readable, default outside production) | json (one object per line, default in production)
# LOG_FORMAT=pretty
# Every line also goes to <LOG_DIR>/<YYYY-MM-DD>.log (one file per day). LOG_TO_FILE=false turns it off.
# LOG_DIR=./logs

# SQLite file for orders, trades and state
DB_PATH=./db/trade-bot.sqlite

# Broker for market data and orders (only upstox so far)
BROKER=upstox

# Upstox developer app (https://account.upstox.com/developer/apps).
# The redirect URL here must exactly match the one saved in the app.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

# paper (default): live prices, simulated fills, no real orders
# live: REAL ORDERS. Also requires LIVE_TRADING_CONFIRM=yes
TRADING_MODE=paper
# LIVE_TRADING_CONFIRM=yes
# Capital the strategy sizes its stop loss from (rupees)
CAPITAL=500000

# Iron butterfly (NIFTY, intraday). Defaults shown.
# IB_LOTS=1
# IB_WING_DISTANCE=400
# IB_STOP_LOSS_PCT_OF_CAPITAL=1
# IB_TARGET_PCT_OF_MAX_PROFIT=40
# 0 = trade the nearest expiry even on expiry day; 1 = use the next expiry on expiry day
# IB_MIN_DAYS_TO_EXPIRY=0
# Days not to trade (events), comma-separated
# IB_SKIP_DATES=2026-12-05,2027-02-01

# Dashboard (`bun run dashboard`). Run `bun run dashboard:setup` to get the three values below.
# 127.0.0.1 = only this machine; on a VPS reach it through an SSH tunnel or Tailscale.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=4000
DASHBOARD_PASSWORD_HASH=
DASHBOARD_PIN_HASH=
DASHBOARD_SESSION_SECRET=
# How long a dashboard login lasts
# DASHBOARD_SESSION_HOURS=24
# true when served over HTTPS (cookie is then sent only over HTTPS)
# DASHBOARD_SECURE_COOKIE=false
