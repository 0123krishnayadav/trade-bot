# Copy to .env and fill in. Bun loads .env automatically; never commit .env.

# development | test | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info
# pretty (readable, default outside production) | json (one object per line, default in production)
# LOG_FORMAT=pretty

# SQLite file for orders, trades and state
DB_PATH=./db/trade-bot.sqlite

# Broker for market data and orders (only upstox so far)
BROKER=upstox

# Upstox developer app (https://account.upstox.com/developer/apps).
# The redirect URL here must exactly match the one saved in the app.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
